[Unit]
Description=CyberRadar Backend Server
After=network.target

[Service]
Type=simple
User=root
# Put the absolute path to the binary you downloaded below!
ExecStart=#PATH_GOES_HERE
Restart=always
RestartSec=5s

# Put port you want to host the backend on below!
Environment=PORT=#PORT_GOES_HERE

[Install]
WantedBy=multi-user.target