[Unit]
Description=CyberRadar Backend Server
After=network.target

[Service]
Type=simple
User=root
ExecStart=#PUT ABSOLUTE PATH TO BINARY HERE
Restart=always
RestartSec=5s

# Fill configuration below!
Environment=PORT=#PUT PORT HERE (String)
Environment=ADVISORY_PAGES=#PUT AMOUNT OF PAGES_TO_BE_FETCHED_HERE_(u16)
Environment=ADVISORIES_UPDATE_INTERVAL=#PUT TIME BETWEEN ADVISORY LIST UPDATES HERE (u64)
Environment=LOG_RESPONSES=#PUT IF RESPONSES SHOULD BE LOGGED (bool)

[Install]
WantedBy=multi-user.target