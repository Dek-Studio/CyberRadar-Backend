[Unit]
Description=CyberRadar Backend Server
After=network.target

[Service]
Type=simple
User=root
ExecStart=#PUT ABSOLUTE PATH TO BINARY HERE
Restart=always
RestartSec=5s

# Fill configuration below!
Environment=PORT=#PUT PORT HERE (u16)
Environment=ADVISORY_PAGES=#PUT AMOUNT OF PAGES TO BE FETCHED HERE (u16)
Environment=DATA_UPDATE_INTERVAL=#PUT TIME BETWEEN DATA UPDATES HERE (u64)
Environment=LOG_RESPONSES=#PUT IF RESPONSES SHOULD BE LOGGED (bool)
Environment=MSG_CHECKER_KEYWORDS_PATH=#PUT PATH TO KEYWORDS FILE (Absolute path as string)

[Install]
WantedBy=multi-user.target